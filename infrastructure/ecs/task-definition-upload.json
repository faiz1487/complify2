{
  "family": "document-services-upload",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "3072",
  "containerDefinitions": [
    {
      "name": "upload-service",
      "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/document-services/upload-service:latest",
      "essential": true,
      "portMappings": [{ "containerPort": 4000, "protocol": "tcp" }],
      "environment": [
        { "name": "S3_PREFIX_RAW", "value": "upload/" },
        { "name": "SQS_QUEUE_URL", "value": "<SQS_QUEUE_URL>" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/document-services/upload-service",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
